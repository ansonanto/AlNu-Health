# AlNu Health Environment Variables Example
# Copy this file to .env and fill in your actual values

# Required for vector database functionality
OPENAI_API_KEY=your-openai-api-key

# Optional - for PubMed API access (improves PubMed downloader functionality)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
NCBI_API_KEY=your-ncbi-api-key

# Optional - for email notifications
EMAIL_ID=your-email@example.com

# Database settings (defaults are usually fine)
# CHROMA_PATH=./chroma_db

# Model settings (defaults are usually fine)
# MODEL_NAME=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
